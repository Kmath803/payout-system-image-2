
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payout System Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #020b18;
      font-family: Arial, sans-serif;
      color: white;
    }

    .header {
      padding: 16px;
      text-align: center;
      background: #041426;
      border-bottom: 1px solid #087b9e;
    }

    .header h1 {
      margin: 0;
      color: #00e5ff;
      font-size: 22px;
    }

    .header p {
      margin-bottom: 0;
      font-size: 13px;
      color: #b8d7ee;
    }

    .image-container {
      padding: 12px;
      text-align: center;
    }

    .dashboard {
      display: block;
      width: 100%;
      height: auto;
      max-width: 1600px;
      margin: 0 auto;
      border: 1px solid #087b9e;
      border-radius: 8px;
    }

    .footer {
      text-align: center;
      padding: 14px;
      color: #9bb4ca;
      font-size: 12px;
    }
  </style>
</head>

<body>
  <header class="header">
    <h1>PAYOUT SYSTEM</h1>
    <p>Technical Control Console — Image Display</p>
  </header>

  <main class="image-container">
    <img
      class="dashboard"
      src="./payout-dashboard.jpg"
      alt="Payout System Dashboard"
    >
  </main>

  <footer class="footer">
    Payout System | Image Display
  </footer>
</body>
</html>
